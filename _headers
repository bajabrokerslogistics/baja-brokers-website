/*
  # Fuerza HTTPS y previene ataques de protocolo
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Evita que el sitio se cargue dentro de un iframe (clickjacking)
  X-Frame-Options: DENY

  # Evita que el navegador adivine el tipo de archivo (MIME sniffing)
  X-Content-Type-Options: nosniff

  # Controla qué información se envía al hacer clic en links externos
  Referrer-Policy: strict-origin-when-cross-origin

  # Restringe acceso a funciones del navegador (cámara, micrófono, etc.)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy reforzada
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src 'self' https://logo.clearbit.com data:; base-uri 'self'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests;
